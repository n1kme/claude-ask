{
  "name": "claude-ask",
  "version": "0.1.0",
  "description": "One-shot command-line tool for Claude: streams answers, scriptable in CI and shell pipelines",
  "license": "ISC",
  "author": "Nikita Merezhko <dev@nim.ee>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ask": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "prepare": "npm run build",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.7",
    "ora": "8.2.0"
  },
  "bin": {
    "claude-ask": "dist/cli/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  },
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.12"
  }
}
